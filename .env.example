# 复制为 .env 后再按需修改。不要把真实 .env 或 TRANS_HF_TOKEN 提交到仓库。

# ── 应用 / 网络 ─────────────────────────────────────
TRANS_HOST=127.0.0.1
TRANS_PORT=8766
TRANS_MAX_STREAM_SESSIONS=1
TRANS_WEBSOCKET_MAX_MESSAGE_BYTES=262144
TRANS_STREAM_SEGMENT_QUEUE_MAX_SIZE=3
TRANS_MODEL_MIN_FREE_DISK_GB=2.0

# ── 硬件 / 模型策略 ─────────────────────────────────
# auto | speed | balanced | quality | cloud
TRANS_MODEL_PROFILE=auto

# ── ASR ──────────────────────────────────────────────
# 后端: auto | qwen3 | mlx | ct2 | openvino | transformers-distil | transformers-whisper | cloud
# auto 会根据硬件选择：Apple Silicon→qwen3（未装 mlx-audio 时回退 mlx），
# NVIDIA→ct2/CUDA，Intel GPU→openvino，CPU→ct2/int8。
TRANS_ASR_BACKEND=auto
# 是否允许主 ASR 失败后切换其他模型。签名 macOS App 会强制设为 false。
TRANS_ASR_FALLBACKS_ENABLED=true
# Qwen3-ASR 权重，经 mlx-audio 运行。mlx-community 提供 4bit/5bit/6bit/8bit/bf16。
# 默认 8bit：实测比 bf16 快约 30%、少占 1.6GB 内存，准确率不降。
# 可以直接填简写：8bit / 6bit / 4bit / bf16 / 0.6b
TRANS_ASR_QWEN3_MODEL_ID=mlx-community/Qwen3-ASR-1.7B-8bit
TRANS_ASR_MODEL_SIZE=large-v3
# 留空则按硬件策略选默认模型。注意这个变量所有后端共用：
# 指定 Qwen3 权重请用上面的 TRANS_ASR_QWEN3_MODEL_ID，不要在这里填 Whisper 仓库。
# TRANS_ASR_MODEL_ID=
TRANS_ASR_DEVICE=auto
TRANS_ASR_COMPUTE_TYPE=default
TRANS_ASR_MAX_NEW_TOKENS=96
TRANS_ASR_BEAM_SIZE=1
TRANS_ASR_BEST_OF=1
TRANS_ASR_CPU_THREADS=0
TRANS_ASR_CT2_VAD_FILTER=false

# Transformers 后端配置
# 实时多语言推荐: openai/whisper-large-v3-turbo
# 追求最准且能接受更慢: openai/whisper-large-v3
# TRANS_ASR_TRANSFORMERS_DTYPE=auto
# TRANS_ASR_TRANSFORMERS_ATTN=sdpa
TRANS_ASR_CONDITION_ON_PREV_TOKENS=false
TRANS_ASR_TEMPERATURE='[0.0]'
TRANS_ASR_COMPRESSION_RATIO_THRESHOLD=1.35
TRANS_ASR_LOGPROB_THRESHOLD=-1.0
TRANS_ASR_NO_SPEECH_THRESHOLD=0.6

# 实验性 Qwen token 流式识别预览默认关闭；界面开关会按会话覆盖 enabled。
TRANS_ASR_STREAMING_PREVIEW_ENABLED=false
TRANS_ASR_STREAMING_PREVIEW_MIN_INTERVAL_MS=80
TRANS_ASR_STREAMING_PREVIEW_MIN_CHARS=2

# 静音/噪声幻觉过滤，主要拦截 "okay"、"thank you" 这类短噪声结果。
TRANS_ASR_HALLUCINATION_FILTER_ENABLED=true
TRANS_ASR_HALLUCINATION_MAX_DURATION=1.8
TRANS_ASR_HALLUCINATION_LOW_RMS=0.012
TRANS_ASR_HALLUCINATION_LOW_SPEECH_RATIO=0.16
TRANS_ASR_HALLUCINATION_MAX_SPEECH_DURATION=0.75
TRANS_ASR_MIN_CONTENT_CHARS=2

# ── 音频预处理 ───────────────────────────────────────
TRANS_AUDIO_PREPROCESS_ENABLED=true
TRANS_AUDIO_HIGHPASS_FREQ=80.0

# ── 性能监控 ─────────────────────────────────────────
TRANS_PERF_LOG_ENABLED=true

TRANS_AUTO_DOWNLOAD_MODELS=true
TRANS_LOAD_MODELS_ON_STARTUP=true

# ── 翻译记录 ─────────────────────────────────────────
# 默认写入 macOS: ~/Library/Application Support/TransLive/history/YYYY-MM-DD.jsonl
TRANS_TRANSCRIPT_HISTORY_ENABLED=true
# TRANS_TRANSCRIPT_HISTORY_DIR=/Users/you/TransLive/history
TRANS_TRANSCRIPT_HISTORY_MAX_MEMORY=500
TRANS_TRANSCRIPT_HISTORY_RETENTION_DAYS=30

# ── MT (本地 Hy-MT GGUF / 云端) ─────────────────────
TRANS_MT_BACKEND=local
# 下载模型:
#   hf download tencent/Hy-MT2-1.8B-GGUF Hy-MT2-1.8B-Q4_K_M.gguf --local-dir models/
# 或设为你已有的 GGUF 路径。
# 支持 Hy-MT2（推荐，33 语言 / Apache-2.0）和旧的 HY-MT1.5，
# prompt 模板按文件名自动切换，仓库地址也会自动匹配。
TRANS_MT_MODEL_ID=models/Hy-MT2-1.8B-Q4_K_M.gguf
TRANS_MT_DEVICE=auto
TRANS_MT_MAX_NEW_TOKENS=256
TRANS_MT_NUM_BEAMS=1
TRANS_MT_MAX_INPUT_TOKENS=512
# 流式翻译输出节流：降低前端/悬浮窗事件压力，最终译文仍完整输出。
TRANS_MT_STREAM_QUEUE_MAX_SIZE=128
TRANS_MT_STREAM_PARTIAL_MIN_INTERVAL_MS=60
TRANS_MT_STREAM_PARTIAL_MIN_CHARS=6
TRANS_MT_STREAM_TIMEOUT_S=45
TRANS_MT_STREAM_MAX_OUTPUT_CHARS=2000
TRANS_MT_STREAM_STOP_ON_DISCONNECT=true
TRANS_MT_STREAM_QUEUE_PUT_TIMEOUT_S=2
# 清理模型偶发输出的 Translation:/译文: 标签、停止符和 prompt 回显。
TRANS_MT_OUTPUT_CLEANUP_ENABLED=true

# ── 云端推理接口预留 ─────────────────────────────────
# TRANS_MODEL_PROFILE=cloud 或 TRANS_ASR_BACKEND=cloud / TRANS_MT_BACKEND=cloud 时启用。
# 服务端合同见 docs/PROJECT_AUDIT_AND_ROADMAP.md。
TRANS_CLOUD_ENABLED=false
# TRANS_CLOUD_PROVIDER=generic
# TRANS_CLOUD_BASE_URL=https://your-translive-api.example.com
# TRANS_CLOUD_API_KEY=
# TRANS_CLOUD_TIMEOUT_S=30
# TRANS_CLOUD_ASR_ENDPOINT=/v1/asr/transcribe
# TRANS_CLOUD_MT_ENDPOINT=/v1/mt/translate
# TRANS_CLOUD_MT_STREAM_ENDPOINT=/v1/mt/translate-stream
# TRANS_CLOUD_ASR_MODEL=
# TRANS_CLOUD_MT_MODEL=

# 只在私有 .env 中填写真实 token。
# TRANS_HF_TOKEN=your_huggingface_token_if_needed

TRANS_SOURCE_LANG=en
TRANS_TARGET_LANG=zh

# ── VAD ─────────────────────────────────────────────
# VAD 引擎: silero | rms
TRANS_VAD_ENGINE=silero
# Silero 走 onnxruntime（不再需要 PyTorch）。权重按 tag 固定，避免上游静默变化。
# 解析顺序：TRANS_VAD_SILERO_ONNX_PATH → models/silero_vad.onnx → pip 包
#           → torch hub 缓存 → 按下面的 tag 下载（约 2.3MB）。
TRANS_VAD_SILERO_REPO=snakers4/silero-vad:v6.2.1
# TRANS_VAD_SILERO_ONNX_PATH=
TRANS_VAD_SILERO_THRESHOLD=0.6
TRANS_VAD_SILERO_MIN_SPEECH_MS=250

# ── 分段 ────────────────────────────────────────────
TRANS_SEGMENT_MIN_DURATION=1.2
TRANS_SEGMENT_MAX_DURATION=12.0
TRANS_SEGMENT_SILENCE_DURATION_MS=700
# low | balanced | stable。低延迟更快出字幕，稳妥更少断句。
TRANS_SESSION_LATENCY_MODE=balanced
TRANS_AUDIO_VAD_RMS_THRESHOLD=0.01
